-- ============================================================
-- Keycloak 25 / MariaDB
-- Удаление LDAP-пользователей realm test
-- Локальные пользователи сохраняются
-- ============================================================

-- 1. Определяем ID realm
SET @realm_id = (
    SELECT ID
    FROM REALM
    WHERE NAME = 'test'
);

-- Проверяем, что realm найден
SELECT @realm_id AS REALM_ID;

-- Если REALM_ID = NULL, дальнейшие команды НЕ выполнять.

-- 2. Фиксируем список удаляемых пользователей
DROP TEMPORARY TABLE IF EXISTS TMP_KC_USERS_DELETE;

CREATE TEMPORARY TABLE TMP_KC_USERS_DELETE (
    ID VARCHAR(36) NOT NULL PRIMARY KEY
) ENGINE = InnoDB;

INSERT INTO TMP_KC_USERS_DELETE (ID)
SELECT ID
FROM USER_ENTITY
WHERE REALM_ID = @realm_id
  AND FEDERATION_LINK IS NOT NULL;

-- 3. Проверяем список перед удалением
SELECT COUNT(*) AS USERS_TO_DELETE
FROM TMP_KC_USERS_DELETE;

SELECT u.ID, u.USERNAME, u.FEDERATION_LINK
FROM USER_ENTITY u
JOIN TMP_KC_USERS_DELETE t ON t.ID = u.ID
ORDER BY u.USERNAME;

-- ============================================================
-- 4. Удаление зависимых данных
-- ============================================================

START TRANSACTION;

DELETE FROM BROKER_LINK
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM EVENT_ENTITY
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_SESSION
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM OFFLINE_USER_SESSION
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FEDERATED_IDENTITY
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_ATTRIBUTE
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_CONSENT
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_CREDENTIAL
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_GROUP_MEMBERSHIP
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_REQUIRED_ACTION
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM FED_USER_ROLE_MAPPING
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_CONSENT
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_ATTRIBUTE
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM CREDENTIAL
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_GROUP_MEMBERSHIP
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_REQUIRED_ACTION
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

DELETE FROM USER_ROLE_MAPPING
WHERE USER_ID IN (SELECT ID FROM TMP_KC_USERS_DELETE);

-- ============================================================
-- 5. Удаление самих пользователей
-- ============================================================

DELETE u
FROM USER_ENTITY u
JOIN TMP_KC_USERS_DELETE t ON t.ID = u.ID
WHERE u.REALM_ID = @realm_id
  AND u.FEDERATION_LINK IS NOT NULL;

-- ============================================================
-- 6. Проверка результата перед COMMIT
-- ============================================================

SELECT COUNT(*) AS REMAINING_LDAP_USERS
FROM USER_ENTITY
WHERE REALM_ID = @realm_id
  AND FEDERATION_LINK IS NOT NULL;

-- Если всё корректно:
COMMIT;

-- При необходимости отменить изменения ДО COMMIT:
-- ROLLBACK;

DROP TEMPORARY TABLE IF EXISTS TMP_KC_USERS_DELETE;
