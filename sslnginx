```nginx
# ============================================================
# SSL/TLS configuration for nginx / Keycloak 25
# nginx 1.31.3 + OpenSSL 1.1.1k FIPS
# ============================================================


# ------------------------------------------------------------
# SSL session cache
# ОСТАВЛЕНО БЕЗ ИЗМЕНЕНИЙ.
# Кэш ускоряет повторные TLS-соединения.
# ------------------------------------------------------------
ssl_session_cache shared:SSL:20m;
ssl_session_timeout 1d;


# ------------------------------------------------------------
# Cipher preference
# ОСТАВЛЕНО БЕЗ ИЗМЕНЕНИЙ.
#
# Для TLS 1.2 nginx предпочитает порядок cipher suites,
# заданный сервером.
#
# Для TLS 1.3 этот параметр существенно не влияет на выбор
# TLS 1.3 cipher suite.
# ------------------------------------------------------------
ssl_prefer_server_ciphers on;


# ------------------------------------------------------------
# TLS protocols
#
# ИЗМЕНЕНО 03.09.2026.
#
# БЫЛО:
# ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
#
# СТАЛО:
# TLSv1.2 + TLSv1.3
#
# TLS 1.0 и TLS 1.1 отключены как устаревшие.
# TLS 1.3 уже проверен фактическим подключением:
# TLS_AES_256_GCM_SHA384 успешно согласуется.
#
# Это соответствует рекомендации:
# 1. Включить TLS 1.3 на TLS-терминаторе.
# ------------------------------------------------------------
ssl_protocols TLSv1.2 TLSv1.3;


# ------------------------------------------------------------
# TLS 1.2 cipher suites
#
# ИЗМЕНЕНО.
#
# БЫЛО:
# AESGCM:AES256:AES128:AES:RSA+AESGCM:RSA+AES:
# !aNULL:!MD5:!DSS:!3DES:!ECDH:!DH
#
# Проблема старой настройки:
# она допускала TLS_RSA_* cipher suites, включая:
#
# TLS_RSA_WITH_AES_256_GCM_SHA384
#
# Это статический RSA key exchange без ECDHE.
# Современные JDK security policy могут запрещать такие
# cipher suites, из-за чего Java-клиент/Keycloak не может
# нормально установить TLS 1.2 соединение.
#
# Поэтому для TLS 1.2 задаём явный современный список
# ECDHE-RSA cipher suites.
#
# Рекомендованные cipher suites:
# ECDHE-RSA-AES256-GCM-SHA384
# ECDHE-RSA-AES128-GCM-SHA256
#
# Дополнительно оставлены ECDHE-ECDSA варианты на случай,
# если сертификат/цепочка в будущем будет заменена
# на ECDSA-сертификат.
#
# DHE не добавляем: DH был ранее сознательно отключён,
# и для данной схемы он не нужен.
# ------------------------------------------------------------
ssl_ciphers 'ECDHE-RSA-AES256-GCM-SHA384:
             ECDHE-RSA-AES128-GCM-SHA256:
             ECDHE-ECDSA-AES256-GCM-SHA384:
             ECDHE-ECDSA-AES128-GCM-SHA256';


# ------------------------------------------------------------
# TLS 1.3 cipher suites
#
# TLS 1.3 использует отдельный набор cipher suites.
# Обычный ssl_ciphers выше в первую очередь относится к
# TLS 1.2 и не является способом настройки TLS 1.3 cipher suites.
#
# Рекомендованные TLS 1.3 suites:
#
# TLS_AES_256_GCM_SHA384
# TLS_AES_128_GCM_SHA256
#
# Первый из них уже ФАКТИЧЕСКИ проверен на этом сервере:
#
# TLSv1.3
# TLS_AES_256_GCM_SHA384
#
# Поэтому отдельную настройку TLS 1.3 пока НЕ добавляем:
# оставляем стандартный набор OpenSSL/nginx.
#
# Это намеренно сделано максимально мягко, чтобы не менять
# дополнительно поведение работающего TLS 1.3.
# ------------------------------------------------------------


# ------------------------------------------------------------
# DH parameters
#
# ОСТАВЛЕНО ОТКЛЮЧЁННЫМ.
#
# Ранее DH был сознательно отключён для DRTM.
# Кроме того, в текущем списке TLS 1.2 cipher suites
# используется ECDHE, а DHE cipher suites мы не разрешаем.
#
# Поэтому ssl_dhparam сейчас не требуется.
# ------------------------------------------------------------
# ssl_dhparam /ecc/nginx/ssl/dhparam.pem;


# ------------------------------------------------------------
# ECDH curves
#
# ОСТАВЛЕНО БЕЗ ЯВНОЙ НАСТРОЙКИ.
#
# Ранее:
# ssl_ecdh_curve secp521r1;
#
# Пока специально НЕ меняем это на X25519/secp256r1.
# Причина — OpenSSL 1.1.1k FIPS, поэтому сначала лучше
# проверить фактически доступные/разрешённые кривые.
#
# nginx/OpenSSL самостоятельно выберет подходящую кривую.
# ------------------------------------------------------------
# ssl_ecdh_curve secp521r1;


# ------------------------------------------------------------
# SSL buffer
#
# ПОКА ОСТАВЛЕНО БЕЗ ИЗМЕНЕНИЙ / НЕ ВКЛЮЧАЕМ.
#
# В старом конфиге параметр был закомментирован:
# ssl_buffer_size 4k;
#
# Изменение 8k -> 4k может влиять на производительность/TTFB,
# поэтому сейчас не смешиваем это изменение с изменением
# TLS cipher suites.
#
# Если понадобится отдельно оптимизировать TTFB — проверим
# этот параметр нагрузочным тестом.
# ------------------------------------------------------------
# ssl_buffer_size 4k;


# ------------------------------------------------------------
# OCSP Stapling
#
# В ТЕКУЩЕМ СЕРТИФИКАТЕ nginx не обнаружил OCSP responder URL:
#
# "ssl_stapling" ignored, no OCSP responder URL in certificate
#
# Поэтому OCSP stapling фактически не работает.
#
# Пока оставляем настройки закомментированными, чтобы nginx
# не выдавал это предупреждение при запуске.
#
# Это НЕ влияет на TLS 1.2/TLS 1.3 handshake.
# ------------------------------------------------------------
# ssl_stapling on;
# resolver 8.8.8.8;
# ssl_stapling_verify on;


# ------------------------------------------------------------
# HSTS
#
# В старом конфиге параметр был закомментирован.
# Пока НЕ включаем автоматически.
#
# HSTS заставляет браузер обращаться к сайту только по HTTPS
# в течение max-age.
#
# Перед включением желательно убедиться, что весь данный
# hostname стабильно доступен по HTTPS и HTTP действительно
# не нужен.
#
# При необходимости безопаснее добавить:
#
# add_header Strict-Transport-Security "max-age=31536000" always;
#
# Но это отдельное изменение и к проблеме Keycloak/TLS
# cipher negotiation напрямую не относится.
# ------------------------------------------------------------
# add_header Strict-Transport-Security "max-age=31536000" always;
