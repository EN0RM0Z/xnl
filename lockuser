$username = "petrovis" # Укажите здесь нужный логин

# Ищем пользователя стандартным поиском
$searcher = [adsisearcher]"(samAccountName=$username)"
$user = $searcher.FindOne()

if ($user) {
    # В Constrained Language свойства извлекаются через коллекцию Properties
    $uac = $user.Properties["useraccountcontrol"][0]
    
    # Битовая маска: 2 — аккаунт отключен (ADS_UF_ACCOUNTDISABLE)
    if ($uac -band 2) {
        $status = "Отключена (Disabled)"
        $statusColor = "Red"
    } else {
        $status = "Активна (Enabled)"
        $statusColor = "Green"
    }
    
    # Проверка блокировки (lockoutTime). Если там 0 — все ок. 
    # Если там большое число (временная метка) — аккаунт заблокирован.
    $lockoutTime = $user.Properties["lockouttime"][0]
    if ($lockoutTime -gt 0) {
        $lockStatus = "ЗАБЛОКИРОВАНА (Locked Out)"
        $lockColor = "Red"
    } else {
        $lockStatus = "Не заблокирована"
        $lockColor = "Green"
    }
    
    # Вывод результата
    Write-Host "`n=== Результат проверки (Safe ADSI) для: $username ===" -ForegroundColor Cyan
    Write-Host "Состояние учетной записи: " -NoNewline; Write-Host $status -ForegroundColor $statusColor
    Write-Host "Статус блокировки:        " -NoNewline; Write-Host $lockStatus -ForegroundColor $lockColor
    Write-Host "=================================================`n"

} else {
    Write-Host "`nОшибка: Пользователь '$username' не найден в домене.`n" -ForegroundColor Yellow
}

