```bash
#!/bin/bash

# ============================================================
# Мониторинг доступности Keycloak
# Oracle Linux 8
#
# Запуск через cron каждые 5 минут:
#
# */5 * * * * /opt/keycloak/scripts/check_keycloak.sh
# ============================================================


# ============================================================
# НАСТРОЙКИ ПРОВЕРКИ
# ============================================================

# Проверяемый URL
URL="https://keycloak.test.ru"

# Количество проверок за один цикл
CHECK_ATTEMPTS=30

# Пауза между проверками, секунд
CHECK_DELAY=1

# Минимальное количество успешных проверок HTTP 200
# для признания сайта доступным
MIN_SUCCESS=25

# Через сколько минут отправлять повторное уведомление,
# если сайт продолжает быть недоступен
NOTIFY_INTERVAL=30

# Таймаут установки соединения
CONNECT_TIMEOUT=5

# Максимальное время одного запроса
MAX_TIME=10


# ============================================================
# ФАЙЛЫ
# ============================================================

# Лог
LOGFILE="/opt/keycloak/scripts/log_kk.txt"

# Файл состояния.
# НЕ лог! Используется только для хранения состояния
# между запусками cron.
STATEFILE="/opt/keycloak/scripts/site_monitor.state"

# Файл блокировки от параллельного запуска
LOCKFILE="/opt/keycloak/scripts/site_monitor.lock"


# ============================================================
# НАСТРОЙКИ УВЕДОМЛЕНИЯ
# ============================================================

NOTIFY_URL="https://send.test.ru/message"

SEVERITY="info"
SENDER="ALERT_SENDER"
CHAT_ID="123-123456478"
BOT_TOKEN="123456.fgjhgjhgjhgjhgjhgjh"


# ============================================================
# ФУНКЦИЯ ОТПРАВКИ УВЕДОМЛЕНИЯ
#
# Возвращает:
#   0 - уведомление отправлено успешно
#   1 - ошибка отправки
# ============================================================

send_notification()
{
    local MESSAGE="$1"

    # Формируем корректный JSON через jq.
    # Это безопаснее ручного формирования JSON,
    # особенно если сообщение содержит кавычки
    # или специальные символы.

    DATA=$(jq -n \
        --arg severity "$SEVERITY" \
        --arg sender "$SENDER" \
        --arg chat_id "$CHAT_ID" \
        --arg bot_token "$BOT_TOKEN" \
        --arg text "$MESSAGE" \
        '{
            severity: $severity,
            sender: $sender,
            chat_id: $chat_id,
            bot_token: $bot_token,
            text: $text
        }'
    )

    # Отправляем запрос.
    HTTP_CODE=$(curl \
        --silent \
        --show-error \
        --output /dev/null \
        --write-out "%{http_code}" \
        --request POST \
        --header "accept: */*" \
        --header "Content-Type: application/json" \
        --data "$DATA" \
        --connect-timeout 5 \
        --max-time 10 \
        "$NOTIFY_URL" \
        2>/dev/null
    )

    CURL_EXIT=$?

    # Считаем успешной отправку с HTTP 2xx.
    if [[ "$CURL_EXIT" -eq 0 ]] && \
       [[ "$HTTP_CODE" -ge 200 ]] && \
       [[ "$HTTP_CODE" -lt 300 ]]; then

        return 0

    else

        return 1

    fi
}


# ============================================================
# ЗАЩИТА ОТ ПАРАЛЛЕЛЬНОГО ЗАПУСКА
# ============================================================

exec 200>"$LOCKFILE"

if ! flock -n 200; then
    exit 0
fi


# ============================================================
# ЧТЕНИЕ ПРЕДЫДУЩЕГО СОСТОЯНИЯ
# ============================================================

SITE_STATE="UP"
LAST_NOTIFICATION=0

if [[ -f "$STATEFILE" ]]; then
    source "$STATEFILE"
fi


# ============================================================
# ПРОВЕРКА САЙТА
# ============================================================

SUCCESS_COUNT=0
LAST_STATUS="000"

for ((i=1; i<=CHECK_ATTEMPTS; i++))
do

    STATUS=$(curl \
        --head \
        --insecure \
        --location \
        --connect-timeout "$CONNECT_TIMEOUT" \
        --max-time "$MAX_TIME" \
        --write-out "%{http_code}" \
        --silent \
        --output /dev/null \
        "$URL" \
        2>/dev/null
    )

    CURL_EXIT=$?

    # Если curl завершился с ошибкой,
    # считаем HTTP-код 000.

    if [[ "$CURL_EXIT" -ne 0 ]]; then
        STATUS="000"
    fi

    LAST_STATUS="$STATUS"

    # ========================================================
    # ВАЖНО:
    # Успешной считается ТОЛЬКО HTTP 200.
    # ========================================================

    if [[ "$STATUS" == "200" ]]; then
        ((SUCCESS_COUNT++))
    fi

    if [[ "$i" -lt "$CHECK_ATTEMPTS" ]]; then
        sleep "$CHECK_DELAY"
    fi

done


# ============================================================
# ОПРЕДЕЛЯЕМ ДОСТУПНОСТЬ
# ============================================================

if [[ "$SUCCESS_COUNT" -ge "$MIN_SUCCESS" ]]; then
    SITE_AVAILABLE=1
else
    SITE_AVAILABLE=0
fi


# Текущее время Unix timestamp
NOW=$(date +%s)

# Время для красивого лога
LOG_DATE=$(date +"%Y-%m-%d %T")


# ============================================================
# ФОРМИРУЕМ РЕЗУЛЬТАТ
# ============================================================

LOG_MESSAGE="${LOG_DATE} Успешных: ${SUCCESS_COUNT} из ${CHECK_ATTEMPTS}"


# ============================================================
# САЙТ ДОСТУПЕН
# ============================================================

if [[ "$SITE_AVAILABLE" -eq 1 ]]; then

    # --------------------------------------------------------
    # Если раньше сайт был DOWN,
    # значит сейчас произошло восстановление.
    # --------------------------------------------------------

    if [[ "$SITE_STATE" == "DOWN" ]]; then

        MESSAGE="✅ Keycloak восстановлен. Сайт снова доступен: ${URL}. Успешных проверок: ${SUCCESS_COUNT}/${CHECK_ATTEMPTS}"

        if send_notification "$MESSAGE"; then

            LOG_MESSAGE="${LOG_MESSAGE}, САЙТ ВОССТАНОВЛЕН: УВЕДОМЛЕНИЕ ОТПРАВЛЕНО"

        else

            LOG_MESSAGE="${LOG_MESSAGE}, САЙТ ВОССТАНОВЛЕН: СБОЙ ОТПРАВКИ УВЕДОМЛЕНИЯ"

        fi

    fi


    # После восстановления или при обычной работе
    # состояние сайта — UP.

    SITE_STATE="UP"

    # При нормальной работе таймер уведомлений сбрасываем.
    LAST_NOTIFICATION=0


# ============================================================
# САЙТ НЕДОСТУПЕН
# ============================================================

else

    # --------------------------------------------------------
    # ПЕРВОЕ ОБНАРУЖЕНИЕ НЕДОСТУПНОСТИ
    # --------------------------------------------------------

    if [[ "$SITE_STATE" != "DOWN" ]]; then

        MESSAGE="🚨 Keycloak недоступен! URL: ${URL}. Успешных проверок HTTP 200: ${SUCCESS_COUNT}/${CHECK_ATTEMPTS}. Последний HTTP-код: ${LAST_STATUS}"

        if send_notification "$MESSAGE"; then

            LOG_MESSAGE="${LOG_MESSAGE}, САЙТ НЕ ДОСТУПЕН: УВЕДОМЛЕНИЕ ОТПРАВЛЕНО"

        else

            LOG_MESSAGE="${LOG_MESSAGE}, САЙТ НЕ ДОСТУПЕН: СБОЙ ОТПРАВКИ УВЕДОМЛЕНИЯ"

        fi

        # В любом случае фиксируем,
        # что сайт перешёл в состояние DOWN.

        SITE_STATE="DOWN"

        # Сохраняем время попытки первого уведомления.
        #
        # Важно: здесь сохраняем NOW независимо от того,
        # удалось уведомление или нет.
        #
        # Это предотвращает слишком частые попытки отправки
        # при проблемах самого сервиса уведомлений.

        LAST_NOTIFICATION="$NOW"


    # --------------------------------------------------------
    # САЙТ УЖЕ БЫЛ НЕДОСТУПЕН
    # --------------------------------------------------------

    else

        INTERVAL_SECONDS=$((NOTIFY_INTERVAL * 60))

        ELAPSED=$((NOW - LAST_NOTIFICATION))

        # ----------------------------------------------------
        # Если прошло 30 минут или больше —
        # отправляем повторное уведомление.
        # ----------------------------------------------------

        if [[ "$ELAPSED" -ge "$INTERVAL_SECONDS" ]]; then

            MESSAGE="🚨 Keycloak всё ещё недоступен! URL: ${URL}. Успешных проверок HTTP 200: ${SUCCESS_COUNT}/${CHECK_ATTEMPTS}. Последний HTTP-код: ${LAST_STATUS}. Повторное уведомление."

            if send_notification "$MESSAGE"; then

                LOG_MESSAGE="${LOG_MESSAGE}, САЙТ НЕ ДОСТУПЕН: УВЕДОМЛЕНИЕ ОТПРАВЛЕНО"

            else

                LOG_MESSAGE="${LOG_MESSAGE}, САЙТ НЕ ДОСТУПЕН: СБОЙ ОТПРАВКИ УВЕДОМЛЕНИЯ"

            fi

            LAST_NOTIFICATION="$NOW"

        fi

    fi

fi


# ============================================================
# СОХРАНЯЕМ СОСТОЯНИЕ
# ============================================================

cat > "$STATEFILE" <<EOF
SITE_STATE="$SITE_STATE"
LAST_NOTIFICATION=$LAST_NOTIFICATION
EOF


# ============================================================
# ОДНА СТРОКА В ЛОГ
# ============================================================

echo "$LOG_MESSAGE" >> "$LOGFILE"

exit 0
```
