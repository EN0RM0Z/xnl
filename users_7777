#!/bin/bash

# ============================================
# НАСТРОЙКИ ПОДКЛЮЧЕНИЯ К БАЗЕ ДАННЫХ (Docker)
# ============================================
DB_CONTAINER="mariadb"          # имя контейнера MariaDB
DB_PORT="3306"
DB_NAME="keycloak_db"
DB_USER="keycloak_user"
DB_PASS="P@ssw0rd"
REALM_NAME="coins"              # имя реалма, для которого выгружаем пользователей
# ============================================

# Выходные файлы
LOCAL_FILE="./local_users.csv"
LDAP_FILE="./ldap_users.csv"
HEADER="\"id\",\"username\",\"firstName\",\"lastName\",\"email\",\"enabled\",\"emailVerified\",\"federatedIdentities\",\"LDAP_ID\""

echo "$HEADER" > "$LOCAL_FILE"
echo "$HEADER" > "$LDAP_FILE"

# Проверка, запущен ли контейнер
if ! docker ps --format '{{.Names}}' | grep -q "^${DB_CONTAINER}$"; then
    echo "Ошибка: контейнер $DB_CONTAINER не запущен или не существует." >&2
    exit 1
fi

# Получаем ID реалма
REALM_ID=$(docker exec "$DB_CONTAINER" mysql -h"$DB_CONTAINER" -P"$DB_PORT" -u"$DB_USER" -p"$DB_PASS" "$DB_NAME" -sN -e "SELECT id FROM REALM WHERE name='$REALM_NAME' LIMIT 1;")
if [ -z "$REALM_ID" ]; then
    echo "Ошибка: реалм '$REALM_NAME' не найден в базе данных." >&2
    exit 1
fi
echo "Выгружаем пользователей для реалма: $REALM_NAME (ID: $REALM_ID)"

# SQL-запрос с использованием FEDERATION_LINK для определения LDAP-пользователей
SQL_QUERY=$(cat <<EOF
SELECT 
    u.id,
    u.username,
    u.first_name,
    u.last_name,
    u.email,
    u.enabled,
    u.email_verified,
    u.federation_link
FROM USER_ENTITY u
WHERE u.realm_id = '$REALM_ID'
ORDER BY u.username;
EOF
)

# Выполняем запрос через docker exec
docker exec "$DB_CONTAINER" mysql -h"$DB_CONTAINER" -P"$DB_PORT" -u"$DB_USER" -p"$DB_PASS" "$DB_NAME" --batch --raw --skip-column-names -e "$SQL_QUERY" | while IFS=$'\t' read -r id username firstName lastName email enabled emailVerified federationLink; do
    if [ -n "$federationLink" ] && [ "$federationLink" != "NULL" ]; then
        output="$LDAP_FILE"
        fed_json=""   # в вашей БД нет FEDERATED_IDENTITY, оставляем пустым
        fed_str=""
        ldap_id=$(echo "$federationLink" | sed 's/"/""/g')
    else
        output="$LOCAL_FILE"
        fed_str=""
        ldap_id=""
    fi

    # Экранирование двойных кавычек
    id_esc=$(echo "$id" | sed 's/"/""/g')
    username_esc=$(echo "$username" | sed 's/"/""/g')
    firstName_esc=$(echo "$firstName" | sed 's/"/""/g')
    lastName_esc=$(echo "$lastName" | sed 's/"/""/g')
    email_esc=$(echo "$email" | sed 's/"/""/g')

    echo "\"$id_esc\",\"$username_esc\",\"$firstName_esc\",\"$lastName_esc\",\"$email_esc\",\"$enabled\",\"$emailVerified\",\"$fed_str\",\"$ldap_id\"" >> "$output"
done

echo "Готово. Локальные пользователи: $LOCAL_FILE"
echo "LDAP-пользователи: $LDAP_FILE"
