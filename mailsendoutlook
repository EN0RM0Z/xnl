const item = $input.first().json;

// ---------- Вспомогательные функции (из Format Final Report) ----------
function escapeHTML(text) {
  if (typeof text !== 'string') return '';
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// ---------- Извлечение данных ----------
const instance = escapeHTML(item.keycloak_instance || 'UNKNOWN');
const server   = escapeHTML(item.server_name || 'UNKNOWN');
const batch    = escapeHTML(item.batch_times || 'Нет данных');
const rawMsg   = escapeHTML(item.original_message || '');

// Первое время из batch_times (разделитель "; ")
const firstTime = batch.split('; ')[0] || batch;

// Преобразуем переносы строк в <br> для корректного отображения в email
const formattedMessage = rawMsg
  .replace(/\\n/g, '<br>')
  .replace(/\\\\n/g, '<br>')
  .replace(/\n/g, '<br>'); // на случай, если уже есть символы перевода строки

