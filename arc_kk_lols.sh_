#!/bin/bash

# === ПАРАМЕТРЫ ===
LOG_DIR="/var/log/rsys"
ARCHIVE_DIR="/var/log/rsys/archive"
DAYS_TO_KEEP=10           # через сколько дней архивировать server.log
ARCHIVE_DAYS_TO_KEEP=60   # сколько дней хранить архивы
DAYS_TO_ACCESS=30         # сколько дней хранить access.*.log

# Если файлов по шаблону нет, цикл for не будет обрабатывать строку-шаблон как имя файла
shopt -s nullglob   

# === ТЕКУЩАЯ ДАТА (обрезанная до дня: без часов, минут и секунд) ===
TODAY=$(date +%s -d "$(date +%Y-%m-%d)")

# === ФУНКЦИЯ: преобразует год, месяц и день в timestamp (секунды с 1970-01-01) ===
get_file_date() {
    local year=$1
    local month=$2
    local day=$3
    date -d "$year-$month-$day" +%s
}

# --- ОБРАБОТКА файлов server.log.YYYY-MM-DD[.n] ---
for file in "$LOG_DIR"/server.log.*; do
    [[ -f "$file" ]] || continue   # пропускаем, если не файл

    # Ищем дату в имени файла (регулярное выражение с 3 группами: год, месяц, день)
    if [[ "$file" =~ server\.log\.([0-9]{4})-([0-9]{2})-([0-9]{2}) ]]; then
        # Достаём дату из имени файла
        file_date=$(get_file_date "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")

        # Разница между сегодня и датой файла в днях
        age=$(( (TODAY - file_date) / 86400 ))

        # Архивируем файл, если он старше DAYS_TO_KEEP
        if (( age > DAYS_TO_KEEP )); then
            gzip -f "$file"                  # сжимаем файл (исходник при этом удаляется)
            mv "$file.gz" "$ARCHIVE_DIR"/    # переносим архив в отдельную папку
        fi
    fi
done

# --- УДАЛЕНИЕ архивов, которые слишком старые ---
# find подбирает *.gz в архивной папке и удаляет те, что старше ARCHIVE_DAYS_TO_KEEP
find "$ARCHIVE_DIR" -type f -name "server.log.*.gz" -mtime +$ARCHIVE_DAYS_TO_KEEP -exec rm -f {} \;

# --- ОБРАБОТКА access.YYYY-MM-DD.log ---
for file in "$LOG_DIR"/access.*.log; do
    [[ -f "$file" ]] || continue

    # В имени ищем дату (год-месяц-день)
    if [[ "$file" =~ access\.([0-9]{4})-([0-9]{2})-([0-9]{2})\.log ]]; then
        file_date=$(get_file_date "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
        age=$(( (TODAY - file_date) / 86400 ))

        # Если файл старше DAYS_TO_ACCESS — удаляем
        if (( age > DAYS_TO_ACCESS )); then
            rm -f "$file"
        fi
    fi
done
