docker exec mariadb mysql -u keycloak -p keycloak -e "
SELECT TIME(FROM_UNIXTIME(EVENT_TIME/1000)) as time, 
       COUNT(*) as count,
       CLIENT_ID,
       TYPE
FROM keycloak.EVENT_ENTITY 
WHERE DATE(FROM_UNIXTIME(EVENT_TIME/1000)) = CURDATE()
AND TIME(FROM_UNIXTIME(EVENT_TIME/1000)) BETWEEN '21:00:00' AND '21:10:00'
GROUP BY time, CLIENT_ID, TYPE
ORDER BY count DESC
LIMIT 10;"

docker exec mariadb mysql -u keycloak -p keycloak -e "
SELECT TIME(FROM_UNIXTIME(EVENT_TIME/1000)) as time, 
       CLIENT_ID,
       TYPE,
       USER_ID,
       IP_ADDRESS
FROM keycloak.EVENT_ENTITY 
WHERE DATE(FROM_UNIXTIME(EVENT_TIME/1000)) = CURDATE()
AND TIME(FROM_UNIXTIME(EVENT_TIME/1000)) BETWEEN '21:00:00' AND '21:10:00'
ORDER BY EVENT_TIME DESC
LIMIT 10;"

docker exec mariadb mysql -u keycloak -p keycloak -e "
SELECT 
    FROM_UNIXTIME(EVENT_TIME/1000) as event_time,
    CLIENT_ID,
    TYPE,
    USER_ID,
    IP_ADDRESS
FROM keycloak.EVENT_ENTITY 
