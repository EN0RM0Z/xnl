log-level=INFO,org.keycloak.federation.kerberos:DEBUG,org.keycloak.authentication.authenticators.browser.SpnegoAuthenticator:DEBUG

#!/bin/bash
# Указываем операционной системе, что данный файл нужно выполнять с помощью интерпретатора bash

# Создаем переменную SRC для хранения абсолютного пути к исходному лог-файлу
SRC="/val/log/kecloak/server.log"

# Создаем переменную DEST для хранения абсолютного пути к целевой папке назначения
DEST="/home/user5/klog"

# Выполняем команду mkdir для создания директории, путь к которой хранится в переменной DEST
mkdir -p "$DEST"
# Флаг -p (parents) указывает утилите создать все недостающие родительские папки в пути (например, саму папку user5, если её нет)
# Кроме того, этот флаг предотвращает вывод ошибки и остановку скрипта, если целевая папка уже существует

# Выполняем команду cp для копирования файла из переменной SRC в папку, указанную в переменной DEST
cp "$SRC" "$DEST/"
# Переменные заключены в двойные кавычки для защиты от синтаксических ошибок, если в путях вдруг появятся пробелы

# Выполняем команду chmod для изменения прав доступа к файлам и папкам
chmod -R a+rX "$DEST"
# Флаг -R (recursive) делает обработку рекурсивной, то есть права применяются к самой папке и ко всем файлам/папкам внутри неё
# Символы a+r добавляют право на чтение (read) для всех пользователей (all: владельца, группы и всех остальных)
# Заглавная буква X добавляет право на выполнение/поиск (execute) только для директорий
# Это технически необходимо: без права на выполнение для папки пользователи не смогут "зайти" в неё и прочитать файлы внутри
