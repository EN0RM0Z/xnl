#!/bin/bash

# ====== НАСТРОЙКИ ======
DB_CONTAINER="mariadb"
DB_NAME="keycloak"
DB_USER="keycloak"
DB_PASSWORD="password"

REALM_ID="test"   # <-- укажи нужный realm

OUTPUT_DIR="./export"
mkdir -p "$OUTPUT_DIR"

DATE=$(date +"%Y%m%d_%H%M%S")

OUTPUT_FILE="$OUTPUT_DIR/realm_roles_${REALM_ID}_$DATE.csv"

HEADER='"ROLE_ID";"ROLE_NAME";"ROLE_TYPE";"CLIENT_ID";"DESCRIPTION"'

# ====== ФУНКЦИЯ ВЫГРУЗКИ ======
run_query() {
    local QUERY="$1"
    local FILE="$2"

    echo "$HEADER" > "$FILE"

    docker exec -i "$DB_CONTAINER" mysql \
        -u"$DB_USER" -p"$DB_PASSWORD" -D "$DB_NAME" \
        --batch --skip-column-names \
        -e "$QUERY" >> "$FILE"
}

# ====== РОЛИ REALM И КЛИЕНТОВ ======
ROLES_QUERY="
SELECT CONCAT(
    '\"', r.ID, '\";',
    '\"', r.NAME, '\";',
    '\"', CASE
        WHEN r.CLIENT IS NULL THEN 'REALM'
        ELSE 'CLIENT'
    END, '\";',
    '\"', IFNULL(c.CLIENT_ID, ''), '\";',
    '\"', IFNULL(r.DESCRIPTION, ''), '\"'
)
FROM KEYCLOAK_ROLE r
LEFT JOIN CLIENT c
    ON c.ID = r.CLIENT
WHERE r.REALM_ID = '${REALM_ID}'
   OR c.REALM_ID = '${REALM_ID}'
ORDER BY
    CASE WHEN r.CLIENT IS NULL THEN 0 ELSE 1 END,
    c.CLIENT_ID,
    r.NAME;
"

# ====== ЗАПУСК ======
echo "Экспорт ролей realm: $REALM_ID"

run_query "$ROLES_QUERY" "$OUTPUT_FILE"

echo "Готово:"
echo "$OUTPUT_FILE"
