#!/bin/bash
# Управление логированием MariaDB в Docker

MARIADB_CONTAINER="mariadb"  # замените на ваше имя контейнера
MYSQL_ROOT_PASSWORD="your_password"  # замените на ваш пароль

case "$1" in
    "start")
        echo "Включаем расширенное логирование MariaDB..."
        docker exec $MARIADB_CONTAINER mysql -u root -p$MYSQL_ROOT_PASSWORD -e "
        SET GLOBAL general_log = 1;
        SET GLOBAL general_log_file = '/var/lib/mysql/general.log';
        SET GLOBAL slow_query_log = 1;
        SET GLOBAL slow_query_log_file = '/var/lib/mysql/slow_queries.log';
        SET GLOBAL long_query_time = 1;
        SET GLOBAL log_queries_not_using_indexes = 1;
        SET GLOBAL log_slow_verbosity = 'query_plan,explain,innodb';
        SET GLOBAL log_slow_rate_limit = 1;
        SET GLOBAL innodb_status_output = 1;
        SET GLOBAL innodb_status_output_locks = 1;
        SHOW VARIABLES LIKE '%log%';
        "
        ;;
    "stop")
        echo "Отключаем логирование MariaDB..."
        docker exec $MARIADB_CONTAINER mysql -u root -p$MYSQL_ROOT_PASSWORD -e "
        SET GLOBAL general_log = 0;
        SET GLOBAL slow_query_log = 0;
        SHOW VARIABLES LIKE '%log%';
        "
        ;;
    "status")
        echo "Текущие настройки логирования:"
        docker exec $MARIADB_CONTAINER mysql -u root -p$MYSQL_ROOT_PASSWORD -e "
        SHOW VARIABLES WHERE variable_name LIKE '%log%' OR variable_name LIKE '%long_query%';
        "
        ;;
    "monitor")
        echo "Мониторинг логов в реальном времени..."
        echo "General log:"
        tail -f /opt/mariadb/data/general.log &
        echo "Slow queries:"
        tail -f /opt/mariadb/data/slow_queries.log &
        echo "Error log:"
        tail -f /opt/mariadb/data/mysql_error.log &
        ;;
    *)
        echo "Использование: $0 {start|stop|status|monitor}"
        exit 1
        ;;
esac
