openssl s_client -connect dc01.vc.virtual.com:636 -showcerts </dev/null 2>/dev/null | awk '/-----BEGIN CERTIFICATE-----/{flag=1} flag{print} /-----END CERTIFICATE-----/{flag=0}' | awk 'BEGIN{RS="-----END CERTIFICATE-----"} /-----BEGIN CERTIFICATE-----/{print $0 "-----END CERTIFICATE-----"}' | while read -r cert; do echo "$cert" | openssl x509 -noout -subject -issuer | grep -E "subject=|issuer="; echo "$cert" | openssl x509 -noout -text | grep "Signature Algorithm" | head -n 1; echo "--------------------------------------------------"; done
