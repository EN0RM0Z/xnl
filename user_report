#!/bin/bash

# ====== НАСТРОЙКИ ======
DB_CONTAINER="mariadb"
DB_NAME="keycloak"
DB_USER="keycloak"
DB_PASSWORD="password"

OUTPUT_FILE="./realm_user_report_detailed.csv"

# ====== HEADER ======
HEADER="\"REALM\";\"SOURCE\";\"USERS_COUNT\""

echo "Формируем детальный отчёт по realm и LDAP..."

# ====== BOM + HEADER ======
printf '\xEF\xBB\xBF%s\n' "$HEADER" > "$OUTPUT_FILE"

# ====== SQL ======
read -r -d '' QUERY <<'EOF'
SELECT CONCAT(
  '"', r.NAME, '";',
  '"', COALESCE(u.FEDERATION_LINK, 'LOCAL'), '";',
  '"', COUNT(u.ID), '"'
)
FROM REALM r
LEFT JOIN USER_ENTITY u ON u.REALM_ID = r.ID
GROUP BY r.NAME, COALESCE(u.FEDERATION_LINK, 'LOCAL')
ORDER BY r.NAME, SOURCE;
EOF

# ====== ВЫПОЛНЕНИЕ ======
docker exec -i "$DB_CONTAINER" mysql \
  -u"$DB_USER" -p"$DB_PASSWORD" -D "$DB_NAME" \
  --batch --skip-column-names \
  -e "$QUERY" >> "$OUTPUT_FILE"

echo "Готово: $OUTPUT_FILE"
