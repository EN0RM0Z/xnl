#!/bin/bash

# ====== НАСТРОЙКИ ======
DB_CONTAINER="mariadb"        # имя контейнера MariaDB
DB_NAME="keycloak"            # имя базы
DB_USER="keycloak"            # пользователь
DB_PASSWORD="password"        # пароль

OUTPUT_DIR="./export"
mkdir -p "$OUTPUT_DIR"

DATE=$(date +"%Y%m%d_%H%M%S")

LDAP_FILE="$OUTPUT_DIR/ldap_users_$DATE.csv"
LOCAL_FILE="$OUTPUT_DIR/local_users_$DATE.csv"

# ====== ФУНКЦИЯ ВЫГРУЗКИ ======
run_query() {
  local QUERY=$1
  local FILE=$2

  docker exec -i $DB_CONTAINER mysql \
    -u$DB_USER -p$DB_PASSWORD -D $DB_NAME \
    --batch --skip-column-names \
    -e "$QUERY" > "$FILE"
}

# ====== LDAP ПОЛЬЗОВАТЕЛИ ======
LDAP_QUERY="
SELECT CONCAT(
  '\"', ID, '\";', 
  '\"', USERNAME, '\";', 
  '\"', EMAIL, '\";', 
  '\"', FIRST_NAME, '\";', 
  '\"', LAST_NAME, '\";', 
  '\"', FEDERATION_LINK, '\"'
)
FROM USER_ENTITY
WHERE FEDERATION_LINK IS NOT NULL;
"

# ====== ЛОКАЛЬНЫЕ ПОЛЬЗОВАТЕЛИ ======
LOCAL_QUERY="
SELECT CONCAT(
  '\"', ID, '\";', 
  '\"', USERNAME, '\";', 
  '\"', EMAIL, '\";', 
  '\"', FIRST_NAME, '\";', 
  '\"', LAST_NAME, '\";', 
  '\"', FEDERATION_LINK, '\"'
)
FROM USER_ENTITY
WHERE FEDERATION_LINK IS NULL;
"

echo "Экспорт LDAP пользователей..."
run_query "$LDAP_QUERY" "$LDAP_FILE"

echo "Экспорт локальных пользователей..."
run_query "$LOCAL_QUERY" "$LOCAL_FILE"

echo "Готово:"
echo "LDAP:  $LDAP_FILE"
echo "LOCAL: $LOCAL_FILE"
