for c in TLS_AES_256_GCM_SHA384 TLS_AES_128_GCM_SHA256 TLS_CHACHA20_POLY1305_SHA256 TLS_AES_128_CCM_SHA256; do
    echo -n "$c: "
    timeout 3 openssl s_client \
        -connect keycloak.test.ru:443 \
        -servername keycloak.test.ru \
        -tls1_3 \
        -ciphersuites "$c" </dev/null 2>&1 |
        grep "Cipher is" | head -1
done
