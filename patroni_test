config.sh
#!/bin/bash

# ==========================================
# Настройки подключения
# ==========================================

DB_HOST="192.168.1.100"       # VIP
DB_NAME="keycloak"
DB_USER="keycloak"

# Пароль лучше задавать через PGPASSWORD
# или ~/.pgpass, а не хранить здесь.
#
# export PGPASSWORD="пароль"

# ==========================================
# Порты
# ==========================================

DB_PRIMARY_PORT=5000
DB_REPLICA_PORT=5001

# ==========================================
# Тест
# ==========================================

# Интервал между операциями RW-теста
RW_INTERVAL=1

# Интервал проверки Replica
REPLICA_INTERVAL=2

# Таймаут подключения
CONNECT_TIMEOUT=2

# ==========================================
# Таблица
# ==========================================

TEST_TABLE="patroni_ha_test"

# ==========================================
# Логи
# ==========================================

LOG_DIR="/var/log/patroni-test"

RW_LOG="${LOG_DIR}/db_rw_test.log"
REPLICA_LOG="${LOG_DIR}/db_replica_test.log"
