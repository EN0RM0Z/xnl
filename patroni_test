#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/config.sh"

mkdir -p "$LOG_DIR"

echo "=========================================="
echo " Patroni HA test - REPLICA"
echo "=========================================="
echo "Host       : $DB_HOST"
echo "Port       : $DB_REPLICA_PORT"
echo "Database   : $DB_NAME"
echo "Interval   : ${REPLICA_INTERVAL}s"
echo "Log        : $REPLICA_LOG"
echo
echo "Для остановки нажмите Ctrl+C"
echo "=========================================="
echo

while true
do

    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S.%3N')

    START=$(date +%s%3N)

    RESULT=$(psql \
        "host=${DB_HOST} port=${DB_REPLICA_PORT} dbname=${DB_NAME} user=${DB_USER} connect_timeout=${CONNECT_TIMEOUT}" \
        -X \
        -A \
        -t \
        -q \
        -v ON_ERROR_STOP=1 \
        -c "
            SELECT
                inet_server_addr() || '|' ||
                inet_server_port() || '|' ||
                CASE
                    WHEN pg_is_in_recovery()
                    THEN 'REPLICA'
                    ELSE 'PRIMARY'
                END;
        " 2>&1)

    RC=$?

    END=$(date +%s%3N)
    ELAPSED=$((END - START))

    RESULT=$(echo "$RESULT" | xargs)

    if [ "$RC" -eq 0 ]; then

        SERVER=$(echo "$RESULT" | awk -F'|' '{print $1}')
        PORT=$(echo "$RESULT" | awk -F'|' '{print $2}')
        ROLE=$(echo "$RESULT" | awk -F'|' '{print $3}')

        if [ "$ROLE" = "REPLICA" ]; then
            STATUS="OK"
        else
            STATUS="WARNING"
        fi

        echo "${TIMESTAMP} | STATUS=${STATUS} | SERVER=${SERVER} | ROLE=${ROLE} | ${ELAPSED}ms"

        echo "${TIMESTAMP} | STATUS=${STATUS} | SERVER=${SERVER} | PORT=${PORT} | ROLE=${ROLE} | TIME=${ELAPSED}ms" \
            >> "$REPLICA_LOG"

    else

        echo "${TIMESTAMP} | STATUS=FAIL | TIME=${ELAPSED}ms | ERROR=${RESULT}"

        echo "${TIMESTAMP} | STATUS=FAIL | TIME=${ELAPSED}ms | ERROR=${RESULT}" \
            >> "$REPLICA_LOG"

    fi

    sleep "$REPLICA_INTERVAL"

done
