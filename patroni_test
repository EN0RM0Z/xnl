#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/config.sh"

echo "=========================================="
echo " Patroni HA test - prepare database"
echo "=========================================="
echo

echo "Проверка подключения к ${DB_HOST}:${DB_PRIMARY_PORT}..."

psql \
    "host=${DB_HOST} port=${DB_PRIMARY_PORT} dbname=${DB_NAME} user=${DB_USER} connect_timeout=${CONNECT_TIMEOUT}" \
    -X \
    -v ON_ERROR_STOP=1 \
    -c "SELECT
            inet_server_addr() AS server,
            inet_server_port() AS port,
            CASE
                WHEN pg_is_in_recovery()
                THEN 'REPLICA'
                ELSE 'PRIMARY'
            END AS role;"

if [ $? -ne 0 ]; then
    echo
    echo "ОШИБКА: невозможно подключиться к PostgreSQL через port ${DB_PRIMARY_PORT}"
    exit 1
fi

echo
echo "Создание таблицы ${TEST_TABLE}..."

psql \
    "host=${DB_HOST} port=${DB_PRIMARY_PORT} dbname=${DB_NAME} user=${DB_USER} connect_timeout=${CONNECT_TIMEOUT}" \
    -X \
    -v ON_ERROR_STOP=1 \
    <<EOF

CREATE TABLE IF NOT EXISTS ${TEST_TABLE} (
    id          BIGINT PRIMARY KEY,
    created_at  TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    test_value  TEXT NOT NULL
);

TRUNCATE TABLE ${TEST_TABLE};

EOF

if [ $? -ne 0 ]; then
    echo
    echo "ОШИБКА при создании/очистке таблицы."
    exit 1
fi

echo
echo "Таблица ${TEST_TABLE} готова."
echo "Старые тестовые данные удалены."
echo
echo "Подготовка завершена успешно."
